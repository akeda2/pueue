# This is the service file for the pueue daemon.
# The installer rewrites ExecStart to the selected install location.
# To enable the daemon type `systemctl --user enable --now pueued.service`
# To start the daemon type `systemctl --user start pueued.service`

[Unit]
Description=Pueue Daemon - CLI process scheduler and manager

[Service]
Restart=no
ExecStart=/usr/bin/pueued -vv

[Install]
WantedBy=default.target
